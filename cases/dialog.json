{
  "$schema": "./schema.json",
  "component": "dialog",
  "cases": [
    {
      "id": "confirm-emits-onconfirm",
      "name": "点击确认触发 onConfirm",
      "given": { "props": { "visible": true, "title": "提示" } },
      "when": { "action": "click", "target": "confirm" },
      "then": {
        "events": [{ "name": "onConfirm", "assertion": "emitted", "times": 1 }]
      }
    },
    {
      "id": "cancel-emits-oncancel",
      "name": "点击取消触发 onCancel",
      "given": { "props": { "visible": true, "title": "提示" } },
      "when": { "action": "click", "target": "cancel" },
      "then": {
        "events": [{ "name": "onCancel", "assertion": "emitted", "times": 1 }]
      }
    },
    {
      "id": "confirm-also-emits-onclose",
      "name": "确认后触发 onClose",
      "given": { "props": { "visible": true, "title": "提示" } },
      "when": { "action": "click", "target": "confirm" },
      "then": {
        "events": [{ "name": "onClose", "assertion": "emitted", "times": 1 }]
      }
    },
    {
      "id": "closable-overlay-emits-onclose",
      "name": "可关闭时点遮罩触发 onClose",
      "given": { "props": { "visible": true, "closable": true } },
      "when": { "action": "click", "target": "overlay" },
      "then": {
        "events": [{ "name": "onClose", "assertion": "emitted", "times": 1 }]
      }
    },
    {
      "id": "not-closable-blocks-overlay-close",
      "name": "不可关闭时点遮罩不触发 onClose",
      "given": { "props": { "visible": true, "closable": false } },
      "when": { "action": "click", "target": "overlay" },
      "then": {
        "events": [{ "name": "onClose", "assertion": "notEmitted" }]
      }
    },
    {
      "id": "hidden-not-rendered",
      "name": "不可见时不渲染",
      "given": { "props": { "visible": false } },
      "when": { "action": "render" },
      "then": { "visible": false, "notes": "不发射任何绘制指令" }
    },
    {
      "id": "title-renders-text",
      "name": "标题被渲染",
      "given": { "props": { "visible": true, "title": "删除确认" } },
      "when": { "action": "render" },
      "then": { "text": "删除确认", "visible": true }
    },
    {
      "id": "danger-type-uses-danger-token",
      "name": "危险类型确认按钮消费危险色令牌",
      "given": { "props": { "visible": true, "type": "danger" } },
      "when": { "action": "render" },
      "then": {
        "tokens": [{ "path": "color.danger.default", "applied": true }]
      }
    },
    {
      "id": "confirm-text-fallback-locale",
      "name": "确认文字未传入时取语言包",
      "given": { "props": { "visible": true, "confirmText": "@lh-i18n" } },
      "when": { "action": "render" },
      "then": {
        "text": "确认",
        "visible": true,
        "notes": "哨兵值表示未显式传入，回退当前语言包（默认 zh-CN）；宿主切换 LhLocale 后文案随之更新"
      }
    },
    {
      "id": "cancel-text-fallback-locale",
      "name": "取消文字未传入时取语言包",
      "given": { "props": { "visible": true, "cancelText": "@lh-i18n" } },
      "when": { "action": "render" },
      "then": {
        "text": "取消",
        "visible": true,
        "notes": "哨兵值表示未显式传入，回退当前语言包（默认 zh-CN）"
      }
    },
    {
      "id": "confirm-text-explicit-wins",
      "name": "显式传入的确认文字优先于语言包",
      "given": { "props": { "visible": true, "confirmText": "好了" } },
      "when": { "action": "render" },
      "then": { "text": "好了", "visible": true }
    },
    {
      "id": "cancel-text-empty-hides-button",
      "name": "取消文字为空串时不渲染取消按钮",
      "given": { "props": { "visible": true, "cancelText": "" } },
      "when": { "action": "render" },
      "then": {
        "visible": true,
        "notes": "空串语义为隐藏按钮（显式传入优先，不回退语言包）"
      }
    }
  ]
}
