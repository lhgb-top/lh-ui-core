{
  "$schema": "./schema.json",
  "$description": "字体体系（国风字体）。字号为 dimension（px），字重与行高为 number",
  "fontFamily": {
    "value": "'Noto Serif SC', 'STSong', 'SimSun', 'Source Han Serif SC', 'PingFang SC', 'Microsoft YaHei', serif",
    "type": "string",
    "description": "国风衬线字体栈，各端取首个可用族"
  },
  "fontSize": {
    "$type": "dimension",
    "extraLarge": { "value": "20px", "description": "字号 特大" },
    "large": { "value": "18px" },
    "medium": { "value": "16px" },
    "base": { "value": "14px", "description": "正文基准字号" },
    "small": { "value": "13px" },
    "extraSmall": { "value": "12px" }
  },
  "fontWeight": {
    "primary": { "value": 400, "type": "number", "description": "常规字重" },
    "bold": { "value": 600, "type": "number", "description": "加粗字重" }
  },
  "lineHeight": {
    "primary": { "value": 1.8, "type": "number", "description": "正文行高" }
  }
}
