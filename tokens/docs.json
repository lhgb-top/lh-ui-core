{
  "$schema": "./schema.json",
  "$description": "文档 UI 令牌组：原生文档模块（lh-ui-android 的 :docs 模块）与网页文档站共用的表格 / 代码块 / 标题 / 卡片 / 正文样式。颜色一律 ref 到 color.*，尺寸自持",
  "code": {
    "fontFamily": {
      "value": "'Source Code Pro', 'JetBrains Mono', 'Consolas', 'Courier New', monospace",
      "type": "string",
      "description": "代码块等宽字体栈，各端取首个可用族"
    },
    "fontSize": { "value": "13px", "type": "dimension", "description": "代码块字号" },
    "background": { "ref": "color.background.default", "description": "代码块底色" },
    "textColor": { "ref": "color.text.regular", "description": "代码块文字色" },
    "borderRadius": { "value": "4px", "type": "dimension", "description": "代码块圆角" },
    "paddingX": { "value": "12px", "type": "dimension" },
    "paddingY": { "value": "12px", "type": "dimension" }
  },
  "table": {
    "borderWidth": { "value": "1px", "type": "dimension", "description": "表格分割线宽" },
    "borderColor": { "ref": "color.border.lighter", "description": "表格分割线色" },
    "headerBg": { "ref": "color.background.page", "description": "表头行底色" },
    "headerTextColor": { "ref": "color.text.primary", "description": "表头行文字色" },
    "cellPaddingX": { "value": "12px", "type": "dimension" },
    "cellPaddingY": { "value": "8px", "type": "dimension" },
    "fontSize": { "value": "13px", "type": "dimension", "description": "表格文字字号" }
  },
  "heading": {
    "fontSizeH1": { "value": "20px", "type": "dimension", "description": "一级标题（页面标题）" },
    "fontSizeH2": { "value": "18px", "type": "dimension", "description": "二级标题（章节）" },
    "fontSizeH3": { "value": "16px", "type": "dimension", "description": "三级标题（小节）" },
    "color": { "ref": "color.text.primary", "description": "标题文字色" }
  },
  "card": {
    "background": { "ref": "color.surface", "description": "卡片底色" },
    "borderColor": { "ref": "color.border.lighter", "description": "卡片描边色" },
    "borderWidth": { "value": "1px", "type": "dimension" },
    "borderRadius": { "value": "8px", "type": "dimension" },
    "padding": { "value": "16px", "type": "dimension" }
  },
  "prose": {
    "fontSize": { "value": "14px", "type": "dimension", "description": "正文字号" },
    "textColor": { "ref": "color.text.regular", "description": "正文文字色" },
    "secondaryColor": { "ref": "color.text.secondary", "description": "次要说明文字色" }
  }
}
