  fontSize: 14,  // 多行输入框字号
  minHeight: 72,  // 无内容时的最小高度（约三行）
  paddingHorizontal: 12,  // 多行输入框左右内边距
  paddingVertical: 12,  // 多行输入框上下内边距
  textInset: 6,  // TextEditor 文本容器内嵌补偿（SwiftUI 固定行为，叠加占位文字与字数统计定位用）
}

